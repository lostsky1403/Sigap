# Sigap monorepo
node_modules/
.pnpm-store/
dist/
build/
target/
*.exe
*.exe~
*.dll
*.so
*.dylib

# env & secrets
.env
.env.local
*.pem

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Generated (do not commit raw generated pb unless needed for bootstrap)
protos/gen/

# Logs
*.log
npm-debug.log*

# SvelteKit / Next legacy
.svelte-kit/
.output/

# Local AI agent / Grok session artifacts (never commit)
.grok/
.grok
*.grok

# Local AI assistant directories (never commit)
.agents/
.claude/
.kimchi/
.byNara/
.omc/
.trae/

# Design working area: specs are version-controlled; only generated/tmp artifacts are ignored
design/generated/
design/tmp/

# Temporary directories
tmp/
backups/

# Generated Go binaries
apps/api/server


skills-lock.json

# Trae local spec artifacts (generated by the Trae IDE; not source of truth).
# Spec documents live under .trae/specs/<change-id>/ and are intentionally
# excluded — they are agent scratch space, not project documentation.
.trae/

.trae/
.trae-html-share-packages/
.omo/
.grok/

# Playwright E2E runner artifacts (Phase 3B1)
# Local-only test output. The runner is configured to refuse any target that is
# not loopback, so nothing produced here can contain production data.
apps/web/test-results/
apps/web/playwright-report/
apps/web/.playwright/

# Disposable local seeded-stack cluster (Phase 3B1 GATE 2).
# Created by scripts/dev/Start-LocalE2E.ps1. Holds only synthetic demo data and
# is intentionally separate from any Postgres instance on the host.
.local-e2e/
