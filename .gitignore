# The decrypted-image temporary used by the restore helper. It must NEVER be
# committed, and the helper removes it on every exit path (trap EXIT/INT/TERM/HUP).
# This is a second line of defence, not the control itself.
sigap-restore-plain-*.tar.gz
sigap-restore-plain-*.tar.gz.age
sigap-pre-redesign-*.tar.gz.age
sigap-pre-redesign-*.tar.gz

# Bucket Lock drill evidence (scripts/ops/Drill-BucketLockRetention.ps1). The
# output is recorded out-of-band on the Jira gate; it must not land in a commit,
# and it must never contain a credential — which is why the script writes only
# command output, never its own environment.
lock-drill-evidence/

# Review scratch: screenshot crops used to read the approved Pen frames while
# comparing them against the running app. Evidence, not source.
.scratch/

# Review captures produced by apps/web/scripts/capture-review.mjs. Regenerable
# from the running local stack, so they are evidence rather than source.
review-shots/

# Go build output (Makefile `build` target writes apps/api/bin/sigap-api).
apps/api/bin/

# Local preview runtime: logs, pid files, and the disposable E2E cluster.
.local-preview/
.local-e2e/

# Playwright artifacts
apps/web/test-results/
apps/web/playwright-report/
