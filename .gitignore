# Sigap monorepo
node_modules/
.pnpm-store/
dist/
build/
target/
*.exe
*.exe~
*.dll
*.so
*.dylib

# env & secrets
.env
.env.local
*.pem

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Generated (do not commit raw generated pb unless needed for bootstrap)
protos/gen/

# Logs
*.log
npm-debug.log*

# SvelteKit / Next legacy
.svelte-kit/
.output/

# Security scan / vulnerability report artifacts (never commit)
# These folders contain sensitive scan results, PoC data, and internal findings.
strix_runs/
vuln_reports/
security_scans/
pentest_results/
poc_*.py

# Local AI agent / Grok session artifacts (never commit)
.grok/
*.grok

# Local AI assistant directories (never commit)
.agents/
.claude/
.kimchi/
.kiro/
.omc/
.trae/
.omo/
.trae-html-share-packages/

# Temporary directories
tmp/
backups/

# Generated Go binaries
apps/api/server

# Trae local spec artifacts (generated by the Trae IDE; not source of truth).
# Spec documents live under .trae/specs/<change-id>/ and are intentionally
# excluded — they are agent scratch space, not project documentation.

skills-lock.json
