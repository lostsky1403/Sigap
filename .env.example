# Sigap environment (copy to .env and adjust)
# .env is gitignored. NEVER commit real credentials.

# --- Postgres credentials (used by docker-compose) ---
POSTGRES_USER=sigap
# Set a strong password locally; compose fails fast if this is unset.
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=sigap

# Connection string for host-run tools (Makefile db-migrate/db-seed).
# Compose builds its own DATABASE_URL from the POSTGRES_* vars above.
# sslmode=require: encrypt the connection. Dev Postgres uses a self-signed cert,
# so "require" (no CA verification) is correct here; use verify-full in prod.
DATABASE_URL="postgresql://sigap:change-me-in-.env@localhost:5433/sigap?sslmode=require"

# Go API
SIGAP_API_PORT=8080
SIGAP_ENGINE_ADDR="http://127.0.0.1:50051"   # gRPC target for Rust engine

# Auth mode: "dev" | "jwt" | "disabled" (default).
#   dev      — synthetic actor from X-Sigap-Dev-User-ID header (requires SIGAP_DEV_IDENTITY=true).
#   jwt      — validate JWT/OIDC tokens (requires issuer, audience below).
#   disabled — fail closed; all requests treated as unauthenticated.
# Production must be "jwt". Never use "dev" in production.
# SIGAP_AUTH_MODE=dev

# OIDC/JWT configuration (required when SIGAP_AUTH_MODE=jwt).
# SIGAP_AUTH_ISSUER=https://accounts.google.com
# SIGAP_AUTH_AUDIENCE=sigap-api-prod
# SIGAP_AUTH_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# CORS: allowed origin for the SvelteKit web UI.
# Default is localhost:3005 for local dev. Change in production.
SIGAP_WEB_ORIGIN="http://localhost:3005"

# Engine fallback: set to 'dev' to allow the API to fall back to a fake queue
# service when the Rust engine is unreachable. In production this should NOT
# be set — the API must fail fast if the engine is down.
# SIGAP_ENGINE_FALLBACK=dev

# gRPC TLS: set to 'true' to enable TLS for the gRPC connection to the engine.
# Dev uses plaintext (insecure). Production MUST use TLS or mTLS.
# SIGAP_GRPC_TLS=true

# Demo PHI: set to 'true' to enable demo medical-records endpoints.
# NEVER enable in production — these endpoints have no authn/authz.
# SIGAP_ENABLE_DEMO_PHI=true

# SvelteKit
PUBLIC_SIGAP_API_BASE="http://localhost:8080"
