[Unit]
Description=Sigap PostgreSQL backup (AUDIT-701)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runtime env (DATABASE_URL, optional SIGAP_BACKUP_S3_*). No secrets in the unit file itself.
EnvironmentFile=-/etc/sigap/backup.env
# Prefer PostgreSQL 16 client tools from PGDG when installed; keep system PATH as fallback.
Environment=PATH=/usr/lib/postgresql/16/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/sigap-backup-postgres.sh
# Structured logging via journald; non-zero exit surfaces as failed unit.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
